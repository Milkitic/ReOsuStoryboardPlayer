    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TrimUnusedDependencies>true</TrimUnusedDependencies>
    <AssemblyVersion>2.8.3.0</AssemblyVersion>
    <FileVersion>2.8.3.0</FileVersion>
